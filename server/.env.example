# Copy to server/.env to override the dev defaults baked into docker-compose.yml.
# Every value here has a dev default in compose; on the faculty VM set real secrets.

POSTGRES_PASSWORD=dev-only-postgres
POS_APP_PASSWORD=dev-only-pos-app

BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=dev-only-bull-board

# Per-instance pool. 3 api × 15 + worker 5 = 50 ≤ 80 (80% of max_connections=100).
DB_POOL_SIZE=15
LOG_LEVEL=info
