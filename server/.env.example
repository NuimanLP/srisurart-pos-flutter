# Copy to server/.env before running docker compose (cp .env.example .env).
# docker-compose.yml enforces that these password variables are set (fails fast if missing).
# For production or VM deployment, replace dev-only values with strong secrets.

POSTGRES_PASSWORD=dev-only-postgres
POS_APP_PASSWORD=dev-only-pos-app

REDIS_PASSWORD=dev-only-redis

BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=dev-only-bull-board

# Per-instance pool. 3 api × 15 + worker 5 = 50 ≤ 80 (80% of max_connections=100).
DB_POOL_SIZE=15
LOG_LEVEL=info
