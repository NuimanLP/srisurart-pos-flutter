{
  "title": "Srisurart POS — infrastructure (local)",
  "uid": "srisurart-pos-infra",
  "tags": ["srisurart-pos"],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Memory per container",
      "type": "timeseries",
      "description": "Working-set memory of each compose service, from cAdvisor. The host Memory panel on the overview dashboard is the sum of these plus the OS; this is the split. Needs deploy/compose/observability.yml — without it every panel here is empty.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(container_memory_working_set_bytes{container_label_com_docker_compose_project=~\"srisurart-.*\"}) by (container_label_com_docker_compose_service)",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Memory used vs. limit per container",
      "type": "bargauge",
      "description": "How close each container is to its compose mem_limit. At 100% the kernel kills it. This is the measured answer to 'does the stack fit' — the sum of the limits is only a ceiling.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "red", "value": 0.9 }] } },
        "overrides": []
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(container_memory_working_set_bytes{container_label_com_docker_compose_project=~\"srisurart-.*\"}) by (container_label_com_docker_compose_service) / sum(container_spec_memory_limit_bytes{container_label_com_docker_compose_project=~\"srisurart-.*\"} > 0) by (container_label_com_docker_compose_service)",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "CPU per container (cores)",
      "type": "timeseries",
      "description": "1.0 is one full core. The host CPU panel says the machine is busy; this says which container is doing it.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=~\"srisurart-.*\"}[5m])) by (container_label_com_docker_compose_service)",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Out-of-memory kills (selected range)",
      "type": "stat",
      "description": "Containers the kernel killed for exceeding mem_limit. Shows 0 when there are none; any tile here names a service that needs a higher limit or has a leak.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "noValue": "0", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(increase(container_oom_events_total{container_label_com_docker_compose_project=~\"srisurart-.*\"}[$__range])) by (container_label_com_docker_compose_service) > 0",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Postgres up",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "noValue": "no data", "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "pg_up",
          "legendFormat": "postgres",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Postgres connections vs. max",
      "type": "timeseries",
      "description": "Every api instance, the worker and bull-board hold their own pools; this is their total against the server's max_connections. The per-instance pool panels on the overview dashboard show who holds them.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 10, "x": 4, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "decimals": 0 },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(pg_stat_database_numbackends)",
          "legendFormat": "in use (all databases)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "pg_settings_max_connections",
          "legendFormat": "max_connections",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "title": "Postgres transactions per second",
      "type": "timeseries",
      "description": "A rollback line that rises with the commit line is ordinary refusals (stock short, validation). Rollbacks rising alone means writes are failing.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "rate(pg_stat_database_xact_commit{datname=\"pos\"}[5m])",
          "legendFormat": "commit",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"pos\"}[5m])",
          "legendFormat": "rollback",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "Database size (pos)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "noValue": "no data" },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "pg_database_size_bytes{datname=\"pos\"}",
          "legendFormat": "pos",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Deadlocks (selected range)",
      "type": "stat",
      "description": "Postgres-detected deadlocks. The money/stock writes follow one lock order (sales → mechanic → products → doc_counters → customer) precisely so this stays 0.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "noValue": "0", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(increase(pg_stat_database_deadlocks{datname=\"pos\"}[$__range]))",
          "legendFormat": "deadlocks",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Redis up",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "fieldConfig": {
        "defaults": { "noValue": "no data", "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "redis_up",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Redis memory used vs. maxmemory",
      "type": "timeseries",
      "description": "At 100% redis-cache starts evicting keys, which is its job. redis-queue holds BullMQ jobs and must never get there.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "red", "value": 0.9 }] } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "redis_memory_used_bytes / (redis_memory_max_bytes > 0)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Redis evicted keys (selected range)",
      "type": "stat",
      "description": "Evictions on redis-cache are normal under memory pressure — the API falls back to Postgres. Any eviction on redis-queue is a lost background job.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 32 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "noValue": "0" },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(increase(redis_evicted_keys_total[$__range])) by (instance)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Redis cache hit ratio (redis-cache)",
      "type": "timeseries",
      "description": "Share of cache lookups answered from Redis, measured server-side over all key lookups. Not the same number as the k6 cache-hit panel, which is one scenario seen from the client. No line when there are no lookups.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 32 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "rate(redis_keyspace_hits_total{instance=\"redis-cache\"}[5m]) / (rate(redis_keyspace_hits_total{instance=\"redis-cache\"}[5m]) + rate(redis_keyspace_misses_total{instance=\"redis-cache\"}[5m]))",
          "legendFormat": "hit ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "title": "Redis commands per second",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "rate(redis_commands_processed_total[5m])",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "title": "Redis connected clients",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "decimals": 0 },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "redis_connected_clients",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    }
  ]
}
